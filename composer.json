{
  "name": "maveius/liphte",
  "type": "library",
  "description": "Lightweight & minimalistic HTML Builder/Generator for PHP",
  "keywords": ["html", "builder", "wrapper", "library"],
  "homepage": "https://github.com/maveius/liphte",
  "license": "MIT",
  "authors": [
    {
      "name": "maveius",
      "email": "maveilthain@gmail.com",
      "homepage": "http://maveius.pl",
      "role": "Developer"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.5",
    "windwalker/dom": "^3.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": { "liphte\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "liphte\\tests\\": "tests/" }
  },
  "config": {
    "platform": { "php": "8.5.0" }
  }
}
